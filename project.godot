; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Other Me"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://scripts/network/network_manager.gd"
PuzzleManager="*res://scripts/puzzles/puzzle_manager.gd"
GameFlowManager="*res://scripts/game_flow/game_flow_manager.gd"
JournalManager="*res://scripts/journal/journal_manager.gd"
CinematicTransitionManager="*res://scripts/cinematic/cinematic_transition_manager.gd"

[gui]

theme/custom="res://assets/themes/game_ui_theme.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=540

