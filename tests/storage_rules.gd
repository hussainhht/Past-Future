extends SceneTree
const Maintenance := preload("res://scripts/puzzles/implementations/maintenance_corridor_puzzle.gd")
const Storage := preload("res://scripts/gameplay/storage/storage_rules.gd")
const Frequency := preload("res://scripts/puzzles/implementations/frequency_puzzle.gd")
var puzzles: Node
var failures := 0
var checks := 0
func _initialize() -> void: run.call_deferred()
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(message)
func state() -> Dictionary: return puzzles.get_state(Maintenance.ID)
func act(action: String, role: String, payload: Dictionary = {}) -> Dictionary:
	return puzzles.submit_action(Maintenance.ID, action, payload, role)
func rejected(action: String, role: String, payload: Dictionary = {}) -> void:
	var before := state()
	var revision: int = puzzles.get_revision(Maintenance.ID)
	check(act(action, role, payload).status == puzzles.Status.REJECTED, "Reject " + action + " " + str(payload))
	check(state() == before and puzzles.get_revision(Maintenance.ID) == revision, "Rejected request cannot mutate inventory or revision")
func run() -> void:
	puzzles = root.get_node("PuzzleManager")
	puzzles.log_rejections = false
	puzzles.register_puzzle(Frequency.ID, Frequency.new())
	puzzles.register_puzzle(Maintenance.ID, Maintenance.new())
	puzzles.submit_action(Frequency.ID, "acquire_radio", {"radio_role": "past"}, "past")
	puzzles.submit_action(Frequency.ID, "acquire_radio", {"radio_role": "future"}, "future")
	puzzles.submit_action(Frequency.ID, "tune_frequency", {"frequency": 67}, "past")
	puzzles.submit_action(Frequency.ID, "tune_amplitude", {"amplitude": 70}, "past")
	rejected("pickup_storage_item", "past", {"item": "r17"})
	act("isolate_service", "past")
	rejected("read_manifest", "future")
	act("charge_battery", "future")
	rejected("read_archive", "future")
	rejected("read_manifest", "past")
	rejected("read_manifest", "future", {"weights": [4.8, 2.6, 7.2]})
	check(act("read_manifest", "future").status == puzzles.Status.CHANGED, "Shipping record is available directly after restoring power")
	for payload in [{"item": "invented"}, {"item": 3}, {"item": "r17", "kg": 4.8}]: rejected("pickup_storage_item", "past", payload)
	for payload in [{"bay": -1}, {"bay": 3}, {"bay": true}, {"bay": 0.0}, {"bay": "0"}, {"bay": 0, "item": "r17"}, {}]: rejected("seal_bay", "past", payload)
	rejected("pickup_storage_item", "future", {"item": "r17"})
	rejected("retrieve_storage_item", "past", {"bay": 0})
	act("seal_bay", "past", {"bay": 0})
	check(state().storage.bays[0].sealed and state().storage.bays[0].item == "", "Empty storage can be sealed")
	rejected("retrieve_storage_item", "future", {"bay": 0})
	rejected("raise_storage_tray", "future", {"bay": 0})
	act("unseal_bay", "past", {"bay": 0})
	# Every portable object can be weighed and preserved, including loose scenery and decoys.
	for item in Storage.ITEMS:
		act("pickup_storage_item", "past", {"item": item})
		rejected("pickup_storage_item", "past", {"item": "r17"})
		act("place_storage_item", "past", {"bay": 0})
		check(state().storage.bays[0].item == item, "Storage accepts " + item)
		rejected("retrieve_storage_item", "future", {"bay": 0})
		act("seal_bay", "past", {"bay": 0})
		check(state().storage.bays[0].sealed, "Seal does not filter " + item)
		rejected("retrieve_storage_item", "future", {"bay": 0})
		rejected("raise_storage_tray", "past", {"bay": 0})
		act("raise_storage_tray", "future", {"bay": 0})
		check(state().storage.bays[0].raised, "Future computer recalls the stored tray before collection")
		rejected("unseal_bay", "past", {"bay": 0})
		act("lower_storage_tray", "future", {"bay": 0})
		check(not state().storage.bays[0].raised, "Recall can be cancelled without losing the object")
		rejected("retrieve_storage_item", "future", {"bay": 0})
		act("raise_storage_tray", "future", {"bay": 0})
		act("retrieve_storage_item", "future", {"bay": 0})
		check(state().storage.future_hand == item, "Future receives the exact object: " + item)
		check(not state().storage.bays[1].sealed and not state().storage.bays[2].sealed, "One bay transfers while the other two are open")
		rejected("retrieve_storage_item", "future", {"bay": 0})
		rejected("unseal_bay", "past", {"bay": 0})
		rejected("return_storage_item", "future", {"bay": 1})
		if Storage.ITEMS[item].part != "reader":
			var before := state()
			var revision: int = puzzles.get_revision(Maintenance.ID)
			var result := act("install_component", "future", {"part": "reader"})
			check(result.status == puzzles.Status.NO_CHANGE and "Professor:" in result.message, "Wrong equipment is reported by Professor at the repair socket")
			check(state() == before and puzzles.get_revision(Maintenance.ID) == revision, "Wrong installation leaves item recoverable")
		act("return_storage_item", "future", {"bay": 0})
		act("unseal_bay", "past", {"bay": 0})
		act("remove_storage_item", "past", {"bay": 0})
		for position in [Vector3(INF, 0, -4), Vector3(0, 1, -4), Vector3(0, 0, 8), Vector3(90, 0, -4)]:
			rejected("drop_storage_item", "past", {"position": position})
		act("drop_storage_item", "past", {"position": Storage.ITEMS[item].home})
		check(state().storage.floor_items.has(item) and state().storage.past_hand.is_empty(), "Incorrect item returns to the Past floor")
		check(not state().storage.bays[0].raised, "Returned equipment lowers into the vault for replacement")
	preload("res://tests/storage_fixture.gd").repair(puzzles)
	check(Storage.repaired(state()), "Three correct parts physically installed")
	check(state().storage.installed == {"reader": "r17", "regulator": "k04", "memory": "m22"}, "Installed inventory retains item identity")
	for index in 3:
		rejected("retrieve_storage_item", "future", {"bay": index})
		rejected("unseal_bay", "past", {"bay": index})
	rejected("install_component", "future", {"part": "reader", "item": "r17"})
	act("read_archive", "future")
	check(state().archive_read and not puzzles.is_solved(Maintenance.ID), "Repair unlocks the story clue while preserving the rest of the chapter")
	puzzles.reset_puzzle(Maintenance.ID)
	check(state().storage == Storage.initial(), "Chapter reset restores all objects, bays and sockets")
	print("STORAGE RULES: %s (%d checks; %d failures)" % ["PASS" if failures == 0 else "FAIL", checks, failures])
	quit(0 if failures == 0 else 1)
